# Copy this file to .env and fill in values. Never commit .env.

# Google Gemini (used by the news cleaner and the report writer)
GEMINI_API_KEY=
GEMINI_MODEL=

# News source: yfinance | finnhub | newsapi
NEWS_PROVIDER=
# Key for the chosen news provider (leave empty for yfinance)
NEWS_API_KEY=

# Sentiment scorer: finbert | gemini
SENTIMENT_PROVIDER=
